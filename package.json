{
  "name": "synesis",
  "displayName": "Synesis",
  "description": "Knowledge Engineering in VS Code: Official LSP client for Synesis.",
  "version": "0.15.2",
  "publisher": "synesis-lang",
  "author": "Christian Maciel De Britto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synesis-lang/synesis-vscode"
  },
  "bugs": {
    "url": "https://github.com/synesis-lang/synesis-vscode/issues"
  },
  "homepage": "https://github.com/synesis-lang/synesis-vscode#readme",
  "icon": "synesis-icon.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "synesis",
    "qualitative research",
    "knowledge engineering",
    "ontology",
    "CAQDAS"
  ],
  "activationEvents": [
    "workspaceContains:*.synp",
    "onChatParticipant:synesis.chatAssistant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "synesis",
        "aliases": [
          "Synesis",
          "synesis"
        ],
        "extensions": [
          ".syn",
          ".synt",
          ".synp",
          ".syno",
          ".synr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "synesis",
        "scopeName": "source.synesis",
        "path": "./syntaxes/synesis.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "synesis",
        "path": "./snippets/synesis.code-snippets"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "synesis",
        "scopes": {
          "keyword": [
            "keyword.control.block.synesis"
          ],
          "variable": [
            "entity.name.reference.synesis"
          ],
          "property": [
            "entity.name.tag.field.synesis"
          ],
          "string": [
            "string.quoted.field.synesis"
          ],
          "enumMember": [
            "variable.other.code.synesis"
          ],
          "namespace": [
            "keyword.control.block.synesis"
          ],
          "comment": [
            "comment.line.synesis"
          ],
          "operator": [
            "keyword.operator.arrow.synesis"
          ],
          "type": [
            "constant.language.relation.synesis"
          ]
        }
      }
    ],
    "themes": [
      {
        "label": "Synesis Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/synesis-dark-theme.json"
      },
      {
        "label": "Synesis Light",
        "uiTheme": "vs",
        "path": "./themes/synesis-light-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "synesis-file-icons",
        "label": "Synesis File Icons",
        "path": "./icons/synesis-file-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synesis",
          "title": "Synesis",
          "icon": "synesis-icon.svg"
        }
      ]
    },
    "views": {
      "synesis": [
        {
          "id": "synesisReferenceExplorer",
          "name": "References"
        },
        {
          "id": "synesisCodeExplorer",
          "name": "Codes",
          "when": "synesis.hasCodes"
        },
        {
          "id": "synesisRelationExplorer",
          "name": "Relations",
          "when": "synesis.hasChains && synesis.activeFileKind == syn"
        },
        {
          "id": "synesisOntologyTopicsExplorer",
          "name": "Ontology Topics",
          "when": "synesis.hasTopics && synesis.activeFileKind == syno"
        },
        {
          "id": "synesisOntologyAnnotationExplorer",
          "name": "Ontology (Annotations)",
          "when": "synesis.hasOntologyAnnotations && synesis.activeFileKind == syn"
        },
        {
          "id": "synesisTemplateExplorer",
          "name": "Template Fields"
        }
      ]
    },
    "commands": [
      {
        "command": "synesis.chat.selectDatabase",
        "title": "Synesis: Selecionar Banco de Grafos do Chat"
      },
      {
        "command": "synesis.chat.auditTrail",
        "title": "Synesis: Ver Evidências e Consultas do Turno"
      },
      {
        "command": "synesis.chat.reassess",
        "title": "Synesis: Reavaliar Resposta (nova execução)"
      },
      {
        "command": "synesis.chat.showMetrics",
        "title": "Synesis: Métricas do Chat (comparar modelos)"
      },
      {
        "command": "synesis.openSettings",
        "title": "Synesis: Configuração",
        "icon": "$(gear)"
      },
      {
        "command": "synesis.lsp.loadProject",
        "title": "Synesis: LSP Load Project"
      },
      {
        "command": "synesis.reference.refresh",
        "title": "Refresh References",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.reference.filter",
        "title": "Filter References",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.reference.filterActive",
        "title": "Filter References",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.code.refresh",
        "title": "Refresh Codes",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.code.filter",
        "title": "Filter Codes",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.code.filterActive",
        "title": "Filter Codes",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.relation.refresh",
        "title": "Refresh Relations",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.relation.filter",
        "title": "Filter Relations",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.relation.filterActive",
        "title": "Filter Relations",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.ontology.refresh",
        "title": "Refresh Ontology Topics",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.ontology.filter",
        "title": "Filter Ontology Topics",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.ontology.filterActive",
        "title": "Filter Ontology Topics",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.ontology.annotation.refresh",
        "title": "Refresh Ontology (Annotations)",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.ontology.annotation.filter",
        "title": "Filter Ontology (Annotations)",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.ontology.annotation.filterActive",
        "title": "Filter Ontology (Annotations)",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.showGraph",
        "title": "Synesis: Show Relation Graph per Source"
      },
      {
        "command": "synesis.showGraphPerFile",
        "title": "Synesis: Show Relation Graph per File"
      },
      {
        "command": "synesis.showGraphPerItem",
        "title": "Synesis: Show Relation Graph per Item"
      },
      {
        "command": "synesis.template.refresh",
        "title": "Refresh Template Fields",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.template.goToField",
        "title": "Go to Field in Template"
      },
      {
        "command": "synesis.showAbstract",
        "title": "Synesis: Show Abstract"
      },
      {
        "command": "synesis.openLocation",
        "title": "Open Location"
      },
      {
        "command": "synesis.code.goToDefinition",
        "title": "Go to Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "synesis.code.rename",
        "title": "Rename Code"
      },
      {
        "command": "synesis.reference.rename",
        "title": "Rename Reference"
      },
      {
        "command": "synesis.coder.codeSelection",
        "title": "Synesis: Code Selection"
      }
    ],
    "keybindings": [
      {
        "command": "synesis.showGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showGraphPerFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showGraphPerItem",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showAbstract",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus && editorLangId == synesis"
      },
      {
        "command": "synesis.code.goToDefinition",
        "key": "F12",
        "when": "focusedView == synesisCodeExplorer"
      },
      {
        "command": "synesis.code.rename",
        "key": "F2",
        "when": "focusedView == synesisCodeExplorer"
      },
      {
        "command": "synesis.reference.rename",
        "key": "F2",
        "when": "focusedView == synesisReferenceExplorer"
      },
      {
        "command": "synesis.coder.codeSelection",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorLangId == synesis && editorHasSelection && synesis.activeFileKind == syn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synesis.reference.refresh",
          "when": "view == synesisReferenceExplorer",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.filter",
          "when": "view == synesisReferenceExplorer && !synesis.reference.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.filterActive",
          "when": "view == synesisReferenceExplorer && synesis.reference.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.code.refresh",
          "when": "view == synesisCodeExplorer",
          "group": "navigation"
        },
        {
          "command": "synesis.code.filter",
          "when": "view == synesisCodeExplorer && !synesis.code.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.code.filterActive",
          "when": "view == synesisCodeExplorer && synesis.code.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.refresh",
          "when": "view == synesisRelationExplorer && synesis.hasChains",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.filter",
          "when": "view == synesisRelationExplorer && synesis.hasChains && !synesis.relation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.filterActive",
          "when": "view == synesisRelationExplorer && synesis.hasChains && synesis.relation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.refresh",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.filter",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno && !synesis.ontology.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.filterActive",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno && synesis.ontology.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.refresh",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.filter",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn && !synesis.ontology.annotation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.filterActive",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn && synesis.ontology.annotation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.template.refresh",
          "when": "view == synesisTemplateExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "synesis.chat.auditTrail",
          "when": "false"
        },
        {
          "command": "synesis.chat.reassess",
          "when": "false"
        },
        {
          "command": "synesis.relation.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.reference.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.code.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.ontology.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.ontology.annotation.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.template.goToField",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "synesis.showGraphPerFile",
          "when": "editorLangId == synesis && synesis.hasChains && synesis.activeFileKind == syn",
          "group": "synesis@1"
        },
        {
          "command": "synesis.showGraphPerItem",
          "when": "editorLangId == synesis && synesis.hasChains && synesis.activeFileKind == syn",
          "group": "synesis@2"
        },
        {
          "command": "synesis.coder.codeSelection",
          "when": "editorLangId == synesis && editorHasSelection && synesis.activeFileKind == syn",
          "group": "1_modification"
        }
      ],
      "view/item/context": [
        {
          "command": "synesis.code.goToDefinition",
          "when": "view == synesisCodeExplorer && viewItem == code",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.rename",
          "when": "view == synesisReferenceExplorer && viewItem == reference",
          "group": "7_modification"
        }
      ]
    },
    "configurationDefaults": {
      "[synesis]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": [
      {
        "title": "Chat (@synesis)",
        "order": 1,
        "properties": {
          "synesisExplorer.chat.credentials": {
            "type": "null",
            "default": null,
            "markdownDescription": "### [⚙️ Abrir a página de configuração do Synesis](command:synesis.openSettings)\n\nÉ lá que ficam **todas** as credenciais do chat `@synesis`, em campos normais — inclusive senhas e chaves de API, que não podem aparecer aqui.\n\nO chat combina **duas coisas independentes**:\n\n- 🗄️ **Banco de grafos** — onde o *seu corpus* está (ArcadeDB ou Neo4j). É de lá que saem os trechos e referências que sustentam cada resposta.\n- 🤖 **Provedor de IA** — qual modelo *lê e redige* (Anthropic, OpenAI, Gemini, OpenRouter). Não guarda o seu corpus: sem uma conexão de grafo, o chat se recusa a responder sobre os dados.\n\n**Por que as senhas não aparecem aqui:** esta página grava em `settings.json`, que é texto puro, sincroniza entre máquinas e é legível por outras extensões. O VSCode não oferece campo de senha — por isso o Synesis tem página própria, gravando no cofre criptografado do sistema operacional.",
            "scope": "application"
          },
          "synesisExplorer.chat.showMetricsButton": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Oferece o botão **Métricas da sessão** ao fim das respostas.\n\nDesligado por padrão: as métricas são **diagnóstico exploratório**, não um veredito sobre qual modelo é mais confiável. A precisão literal verifica que o trecho existe no banco, não que ele sustenta a afirmação; as perguntas-armadilha são genéricas e um corpus que trate legitimamente desses temas seria penalizado; e uma sessão pode misturar modelos e bancos. O comando continua disponível na paleta."
          },
          "synesisExplorer.chat.maxToolRounds": {
            "type": "integer",
            "default": 16,
            "minimum": 4,
            "maximum": 40,
            "markdownDescription": "Quantas consultas ao banco o assistente pode encadear numa resposta.\n\nO limite existe para conter um modelo que entrou em laço, não para economizar chamadas: perguntas que atravessam conceito → trecho → referência gastam várias consultas antes da útil. Abaixo de 8 as respostas ficam incompletas.",
            "scope": "application"
          },
          "synesisExplorer.chat.openRouterModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Modelos do OpenRouter a oferecer no seletor de chat, por id (ex.: `liquid/lfm-2.5-2.6b:free`).\n\nO OpenRouter publica centenas de modelos; em vez de listá-los todos, declare aqui os que quer testar. Nome, janela de contexto e suporte a *tool-calling* sao lidos do catalogo publico do OpenRouter — nao e preciso informa-los.\n\nOs modelos declarados aqui SUBSTITUEM a lista padrao do provedor."
          },
          "synesisExplorer.chat.discoverModels": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Descobrir os modelos disponiveis consultando cada provedor (Anthropic, OpenAI, Gemini), em vez de usar a lista fixa da extensao.\n\nDesligue para manter o seletor estavel durante uma campanha de medicao, ou quando a rede/proxy bloquear as consultas de catalogo. Com a descoberta desligada, valem as listas internas."
          },
          "synesisExplorer.chat.ollama.url": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Endereço do servidor Ollama para usar modelos locais no chat (ex.: `http://localhost:11434`, ou o endereço de um servidor da rede). Em branco, o provedor fica desligado.\n\nNão exige API key: os modelos instalados no servidor aparecem no seletor de chat, com suporte a *tool-calling* lido do próprio Ollama.\n\nEscopo `machine` por segurança: um workspace não confiável não pode redirecionar o chat — e os trechos do seu corpus que vão no prompt — para outro servidor."
          },
          "synesisExplorer.chat.ollama.contextLength": {
            "type": "integer",
            "default": 32768,
            "minimum": 2048,
            "scope": "machine",
            "markdownDescription": "Janela de contexto (tokens) pedida ao Ollama em cada conversa — `num_ctx`. Vale o menor entre este valor e o máximo do modelo.\n\nO Ollama só aloca o que for pedido, e sem pedido usa um padrão pequeno que corta o prompt em silêncio. Valores maiores exigem mais memória de GPU; reduza se o servidor ficar sem VRAM."
          },
          "synesisExplorer.chat.ollama.think": {
            "type": "string",
            "enum": [
              "default",
              "off",
              "low",
              "medium",
              "high"
            ],
            "enumDescriptions": [
              "Não envia o parâmetro: vale o padrão do modelo.",
              "Desliga o raciocínio (no gpt-oss, que não desliga, vira \"low\").",
              "Raciocínio baixo — níveis valem no gpt-oss; nos demais, liga.",
              "Raciocínio médio — níveis valem no gpt-oss; nos demais, liga.",
              "Raciocínio alto — níveis valem no gpt-oss; nos demais, liga."
            ],
            "default": "low",
            "scope": "machine",
            "markdownDescription": "Raciocínio pedido aos modelos do Ollama que pensam — parâmetro `think`.\n\nNo chat o modelo pensa a cada consulta ao banco, inclusive nas que só escolhem a próxima: é o maior custo de tempo num modelo local. Modelos que não declaram raciocínio não recebem o parâmetro."
          },
          "synesisExplorer.chat.ollama.stream": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "markdownDescription": "Receber a resposta do Ollama em pedaços (streaming), à medida que é gerada.\n\nNão encurta a geração. Evita que uma rodada longa estoure o prazo de 5 minutos do `fetch` do Node à espera dos cabeçalhos — o que acontece com modelo local lento sem streaming — e deixa o cancelamento agir no meio da geração. O chat ainda mostra o texto ao fim de cada rodada: ele o retém até saber que não é um passo intermediário antes de uma consulta ao banco."
          },
          "synesisExplorer.chat.arcadedb.uri": {
            "type": "string",
            "default": "http://localhost:2480",
            "scope": "machine",
            "markdownDescription": "**Legado — só para migração.** Endpoint do ArcadeDB da versão anterior, importado como perfil de conexão. Configure conexões na [página de configuração](command:synesis.openSettings).\n\nContinua declarada, com escopo `machine`, por segurança: sem a declaração, um workspace não confiável poderia gravar este valor no próprio `settings.json` e redirecionar a conexão — com a senha guardada no cofre — para outro host.",
            "deprecationMessage": "Legado: configure conexões na página de configuração do Synesis."
          },
          "synesisExplorer.chat.arcadedb.user": {
            "type": "string",
            "default": "root",
            "scope": "machine",
            "markdownDescription": "**Legado — só para migração.** Usuário do ArcadeDB da versão anterior, importado como perfil de conexão. Configure conexões na [página de configuração](command:synesis.openSettings).",
            "deprecationMessage": "Legado: configure conexões na página de configuração do Synesis."
          }
        }
      },
      {
        "title": "Language Server",
        "order": 2,
        "properties": {
          "synesisExplorer.lsp.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Synesis LSP integration."
          },
          "synesisExplorer.lsp.pythonPath": {
            "type": "string",
            "default": "synesis-lsp",
            "scope": "machine",
            "description": "Synesis LSP executable path. Machine-scoped: cannot be overridden by a workspace's .vscode/settings.json, so opening an untrusted project cannot redirect the executable that is launched."
          },
          "synesisExplorer.lsp.args": {
            "type": "array",
            "default": [],
            "scope": "machine",
            "description": "Arguments passed to the Synesis LSP executable (e.g. [\"-m\", \"synesis_lsp\"]). Machine-scoped for the same reason as lsp.pythonPath.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      {
        "title": "Editor",
        "order": 3,
        "properties": {
          "synesisExplorer.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable inline diagnostics (error/warning squiggles) from the Synesis LSP."
          },
          "synesisExplorer.inlayHints.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show inline hints after @bibrefs (e.g. \"(Author, Year)\")."
          },
          "synesisExplorer.semanticHighlighting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable AST-based semantic syntax highlighting (more accurate than TextMate grammar). Requires Synesis Dark or Synesis Light theme, or a theme with semanticTokenColors support."
          },
          "synesisExplorer.completion.autoImportCodes": {
            "type": "boolean",
            "default": true,
            "description": "Include ontology codes from the compiled project in autocomplete suggestions."
          }
        }
      },
      {
        "title": "Coder",
        "order": 4,
        "properties": {
