{
  "name": "synesis",
  "displayName": "Synesis",
  "description": "Knowledge Engineering in VS Code: Official LSP client for Synesis.",
  "version": "0.17.0",
  "publisher": "synesis-lang",
  "author": "Christian Maciel De Britto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synesis-lang/synesis-vscode"
  },
  "bugs": {
    "url": "https://github.com/synesis-lang/synesis-vscode/issues"
  },
  "homepage": "https://github.com/synesis-lang/synesis-vscode#readme",
  "icon": "synesis-icon.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "synesis",
    "qualitative research",
    "knowledge engineering",
    "ontology",
    "CAQDAS"
  ],
  "activationEvents": [
    "workspaceContains:*.synp",
    "onChatParticipant:synesis.chatAssistant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "synesis",
        "aliases": [
          "Synesis",
          "synesis"
        ],
        "extensions": [
          ".syn",
          ".synt",
          ".synp",
          ".syno",
          ".synr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "synesis",
        "scopeName": "source.synesis",
        "path": "./syntaxes/synesis.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "synesis",
        "path": "./snippets/synesis.code-snippets"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "synesis",
        "scopes": {
          "keyword": [
            "keyword.control.block.synesis"
          ],
          "variable": [
            "entity.name.reference.synesis"
          ],
          "property": [
            "entity.name.tag.field.synesis"
          ],
          "string": [
            "string.quoted.field.synesis"
          ],
          "enumMember": [
            "variable.other.code.synesis"
          ],
          "namespace": [
            "keyword.control.block.synesis"
          ],
          "comment": [
            "comment.line.synesis"
          ],
          "operator": [
            "keyword.operator.arrow.synesis"
          ],
          "type": [
            "constant.language.relation.synesis"
          ]
        }
      }
    ],
    "themes": [
      {
        "label": "Synesis Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/synesis-dark-theme.json"
      },
      {
        "label": "Synesis Light",
        "uiTheme": "vs",
        "path": "./themes/synesis-light-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "synesis-file-icons",
        "label": "Synesis File Icons",
        "path": "./icons/synesis-file-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "synesis",
          "title": "Synesis",
          "icon": "synesis-icon.svg"
        }
      ]
    },
    "views": {
      "synesis": [
        {
          "id": "synesisReferenceExplorer",
          "name": "References"
        },
        {
          "id": "synesisCodeExplorer",
          "name": "Codes",
          "when": "synesis.hasCodes"
        },
        {
          "id": "synesisRelationExplorer",
          "name": "Relations",
          "when": "synesis.hasChains && synesis.activeFileKind == syn"
        },
        {
          "id": "synesisOntologyTopicsExplorer",
          "name": "Ontology Topics",
          "when": "synesis.hasTopics && synesis.activeFileKind == syno"
        },
        {
          "id": "synesisOntologyAnnotationExplorer",
          "name": "Ontology (Annotations)",
          "when": "synesis.hasOntologyAnnotations && synesis.activeFileKind == syn"
        },
        {
          "id": "synesisTemplateExplorer",
          "name": "Template Fields"
        }
      ]
    },
    "commands": [
      {
        "command": "synesis.chat.selectDatabase",
        "title": "Synesis: Select Chat Graph Database"
      },
      {
        "command": "synesis.chat.auditTrail",
        "title": "Synesis: Show Turn Evidence and Queries"
      },
      {
        "command": "synesis.chat.reassess",
        "title": "Synesis: Reassess Answer (new run)"
      },
      {
        "command": "synesis.chat.showMetrics",
        "title": "Synesis: Chat Metrics (compare models)"
      },
      {
        "command": "synesis.openSettings",
        "title": "Synesis: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "synesis.lsp.loadProject",
        "title": "Synesis: LSP Load Project"
      },
      {
        "command": "synesis.reference.refresh",
        "title": "Refresh References",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.reference.filter",
        "title": "Filter References",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.reference.filterActive",
        "title": "Filter References",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.code.refresh",
        "title": "Refresh Codes",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.code.filter",
        "title": "Filter Codes",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.code.filterActive",
        "title": "Filter Codes",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.relation.refresh",
        "title": "Refresh Relations",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.relation.filter",
        "title": "Filter Relations",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.relation.filterActive",
        "title": "Filter Relations",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.ontology.refresh",
        "title": "Refresh Ontology Topics",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.ontology.filter",
        "title": "Filter Ontology Topics",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.ontology.filterActive",
        "title": "Filter Ontology Topics",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.ontology.annotation.refresh",
        "title": "Refresh Ontology (Annotations)",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.ontology.annotation.filter",
        "title": "Filter Ontology (Annotations)",
        "icon": "$(filter)"
      },
      {
        "command": "synesis.ontology.annotation.filterActive",
        "title": "Filter Ontology (Annotations)",
        "icon": {
          "light": "icons/filter-red.svg",
          "dark": "icons/filter-red.svg"
        }
      },
      {
        "command": "synesis.showGraph",
        "title": "Synesis: Show Relation Graph per Source"
      },
      {
        "command": "synesis.showGraphPerFile",
        "title": "Synesis: Show Relation Graph per File"
      },
      {
        "command": "synesis.showGraphPerItem",
        "title": "Synesis: Show Relation Graph per Item"
      },
      {
        "command": "synesis.template.refresh",
        "title": "Refresh Template Fields",
        "icon": "$(refresh)"
      },
      {
        "command": "synesis.template.goToField",
        "title": "Go to Field in Template"
      },
      {
        "command": "synesis.showAbstract",
        "title": "Synesis: Show Abstract"
      },
      {
        "command": "synesis.openLocation",
        "title": "Open Location"
      },
      {
        "command": "synesis.code.goToDefinition",
        "title": "Go to Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "synesis.code.rename",
        "title": "Rename Code"
      },
      {
        "command": "synesis.reference.rename",
        "title": "Rename Reference"
      },
      {
        "command": "synesis.coder.codeSelection",
        "title": "Synesis: Code Selection"
      },
      {
        "command": "synesis.ontology.subtreeEvidence",
        "title": "Subtree Evidence",
        "icon": "$(list-tree)"
      }
    ],
    "keybindings": [
      {
        "command": "synesis.showGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showGraphPerFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showGraphPerItem",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == synesis && synesis.hasChains"
      },
      {
        "command": "synesis.showAbstract",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus && editorLangId == synesis"
      },
      {
        "command": "synesis.code.goToDefinition",
        "key": "F12",
        "when": "focusedView == synesisCodeExplorer"
      },
      {
        "command": "synesis.code.rename",
        "key": "F2",
        "when": "focusedView == synesisCodeExplorer"
      },
      {
        "command": "synesis.reference.rename",
        "key": "F2",
        "when": "focusedView == synesisReferenceExplorer"
      },
      {
        "command": "synesis.coder.codeSelection",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorLangId == synesis && editorHasSelection && synesis.activeFileKind == syn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "synesis.reference.refresh",
          "when": "view == synesisReferenceExplorer",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.filter",
          "when": "view == synesisReferenceExplorer && !synesis.reference.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.filterActive",
          "when": "view == synesisReferenceExplorer && synesis.reference.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.code.refresh",
          "when": "view == synesisCodeExplorer",
          "group": "navigation"
        },
        {
          "command": "synesis.code.filter",
          "when": "view == synesisCodeExplorer && !synesis.code.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.code.filterActive",
          "when": "view == synesisCodeExplorer && synesis.code.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.refresh",
          "when": "view == synesisRelationExplorer && synesis.hasChains",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.filter",
          "when": "view == synesisRelationExplorer && synesis.hasChains && !synesis.relation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.relation.filterActive",
          "when": "view == synesisRelationExplorer && synesis.hasChains && synesis.relation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.refresh",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.filter",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno && !synesis.ontology.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.filterActive",
          "when": "view == synesisOntologyTopicsExplorer && synesis.hasTopics && synesis.activeFileKind == syno && synesis.ontology.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.refresh",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.filter",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn && !synesis.ontology.annotation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.ontology.annotation.filterActive",
          "when": "view == synesisOntologyAnnotationExplorer && synesis.hasOntologyAnnotations && synesis.activeFileKind == syn && synesis.ontology.annotation.filterActive",
          "group": "navigation"
        },
        {
          "command": "synesis.template.refresh",
          "when": "view == synesisTemplateExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "synesis.chat.auditTrail",
          "when": "false"
        },
        {
          "command": "synesis.chat.reassess",
          "when": "false"
        },
        {
          "command": "synesis.relation.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.reference.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.code.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.ontology.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.ontology.annotation.filterActive",
          "when": "false"
        },
        {
          "command": "synesis.template.goToField",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "synesis.showGraphPerFile",
          "when": "editorLangId == synesis && synesis.hasChains && synesis.activeFileKind == syn",
          "group": "synesis@1"
        },
        {
          "command": "synesis.showGraphPerItem",
          "when": "editorLangId == synesis && synesis.hasChains && synesis.activeFileKind == syn",
          "group": "synesis@2"
        },
        {
          "command": "synesis.coder.codeSelection",
          "when": "editorLangId == synesis && editorHasSelection && synesis.activeFileKind == syn",
          "group": "1_modification"
        }
      ],
      "view/item/context": [
        {
          "command": "synesis.code.goToDefinition",
          "when": "view == synesisCodeExplorer && viewItem == code",
          "group": "navigation"
        },
        {
          "command": "synesis.reference.rename",
          "when": "view == synesisReferenceExplorer && viewItem == reference",
          "group": "7_modification"
        },
        {
          "command": "synesis.ontology.subtreeEvidence",
          "when": "view == synesisOntologyTopicsExplorer && viewItem == ontologyConcept",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[synesis]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": [
      {
        "title": "Chat (@synesis)",
        "order": 1,
        "properties": {
          "synesisExplorer.chat.credentials": {
            "type": "null",
            "default": null,
            "markdownDescription": "### [⚙️ Open the Synesis settings page](command:synesis.openSettings)\n\nThat is where **all** the credentials of the `@synesis` chat live, in ordinary fields — including passwords and API keys, which cannot appear here.\n\nThe chat combines **two independent things**:\n\n- 🗄️ **Graph database** — where *your corpus* is (ArcadeDB or Neo4j). That is where the excerpts and references supporting each answer come from.\n- 🤖 **AI provider** — which model *reads and writes* (Anthropic, OpenAI, Gemini, OpenRouter). It does not hold your corpus: without a graph connection, the chat refuses to answer about the data.\n\n**Why passwords do not appear here:** this page writes to `settings.json`, which is plain text, syncs across machines and is readable by other extensions. VSCode offers no password field — that is why Synesis has its own page, writing to the operating system's encrypted vault.",
            "scope": "application"
          },
          "synesisExplorer.chat.showMetricsButton": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Offers the **Session metrics** button at the end of answers.\n\nOff by default: the metrics are **exploratory diagnostics**, not a verdict on which model is more reliable. Literal precision checks that the excerpt exists in the database, not that it supports the claim; the trap questions are generic, and a corpus that legitimately covers those topics would be penalised; and a session can mix models and databases. The command remains available in the palette."
          },
          "synesisExplorer.chat.maxToolRounds": {
            "type": "integer",
            "default": 16,
            "minimum": 4,
            "maximum": 40,
            "markdownDescription": "How many database queries the assistant can chain in one answer.\n\nThe limit exists to contain a model stuck in a loop, not to save calls: questions that go concept → excerpt → reference spend several queries before the useful one. Below 8 the answers come out incomplete.",
            "scope": "application"
          },
          "synesisExplorer.chat.openRouterModels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "OpenRouter models to offer in the chat picker, by id (e.g. `liquid/lfm-2.5-2.6b:free`).\n\nOpenRouter publishes hundreds of models; instead of listing them all, declare here the ones you want to test. Name, context window and *tool-calling* support are read from the public OpenRouter catalog — there is no need to enter them.\n\nThe models declared here REPLACE the provider's default list."
          },
          "synesisExplorer.chat.discoverModels": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Discover the available models by querying each provider (Anthropic, OpenAI, Gemini), instead of using the extension's fixed list.\n\nTurn it off to keep the picker stable during a measurement campaign, or when the network/proxy blocks the catalog queries. With discovery off, the internal lists apply."
          },
          "synesisExplorer.chat.ollama.url": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Address of the Ollama server for using local models in the chat (e.g. `http://localhost:11434`, or the address of a server on the network). Blank turns the provider off.\n\nNo API key needed: the models installed on the server show up in the chat picker, with *tool-calling* support read from Ollama itself.\n\n`machine` scope for safety: an untrusted workspace cannot redirect the chat — and the excerpts of your corpus that go into the prompt — to another server."
          },
          "synesisExplorer.chat.ollama.contextLength": {
            "type": "integer",
            "default": 32768,
            "minimum": 2048,
            "scope": "machine",
            "markdownDescription": "Context window (tokens) requested from Ollama in each conversation — `num_ctx`. The smaller of this value and the model maximum applies.\n\nOllama only allocates what is requested, and without a request it uses a small default that silently cuts the prompt. Larger values need more GPU memory; reduce it if the server runs out of VRAM."
          },
          "synesisExplorer.chat.ollama.think": {
            "type": "string",
            "enum": [
              "default",
              "off",
              "low",
              "medium",
              "high"
            ],
            "enumDescriptions": [
              "Does not send the parameter: the model default applies.",
              "Turns reasoning off (on gpt-oss, which cannot turn it off, it becomes \"low\").",
              "Low reasoning — levels apply to gpt-oss; on the others, it turns reasoning on.",
              "Medium reasoning — levels apply to gpt-oss; on the others, it turns reasoning on.",
              "High reasoning — levels apply to gpt-oss; on the others, it turns reasoning on."
            ],
            "default": "low",
            "scope": "machine",
            "markdownDescription": "Reasoning requested from the Ollama models that think — the `think` parameter.\n\nIn the chat the model thinks at every database query, including those that only pick the next one: it is the largest time cost in a local model. Models that do not declare reasoning do not receive the parameter."
          },
          "synesisExplorer.chat.ollama.stream": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "markdownDescription": "Receive the Ollama answer in chunks (streaming), as it is generated.\n\nIt does not shorten generation. It keeps a long round from hitting the 5-minute timeout of Node's `fetch` while waiting for headers — which happens with a slow local model without streaming — and lets cancellation act midway. The chat still shows the text at the end of each round: it holds it until it knows it is not an intermediate step before a database query."
          },
          "synesisExplorer.chat.arcadedb.uri": {
            "type": "string",
            "default": "http://localhost:2480",
            "scope": "machine",
            "markdownDescription": "**Legacy — migration only.** ArcadeDB endpoint from the previous version, imported as a connection profile. Configure connections on the [settings page](command:synesis.openSettings).\n\nIt remains declared, with `machine` scope, for safety: without the declaration, an untrusted workspace could write this value into its own `settings.json` and redirect the connection — with the password stored in the vault — to another host.",
            "deprecationMessage": "Legacy: configure connections on the Synesis settings page."
          },
          "synesisExplorer.chat.arcadedb.user": {
            "type": "string",
            "default": "root",
            "scope": "machine",
            "markdownDescription": "**Legacy — migration only.** ArcadeDB user from the previous version, imported as a connection profile. Configure connections on the [settings page](command:synesis.openSettings).",
            "deprecationMessage": "Legacy: configure connections on the Synesis settings page."
          }
        }
      },
      {
        "title": "Language Server",
        "order": 2,
        "properties": {
          "synesisExplorer.lsp.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Synesis LSP integration."
          },
          "synesisExplorer.lsp.pythonPath": {
            "type": "string",
            "default": "synesis-lsp",
            "scope": "machine",
            "description": "Synesis LSP executable path. Machine-scoped: cannot be overridden by a workspace's .vscode/settings.json, so opening an untrusted project cannot redirect the executable that is launched."
          },
          "synesisExplorer.lsp.args": {
            "type": "array",
            "default": [],
            "scope": "machine",
            "description": "Arguments passed to the Synesis LSP executable (e.g. [\"-m\", \"synesis_lsp\"]). Machine-scoped for the same reason as lsp.pythonPath.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      {
        "title": "Editor",
        "order": 3,
        "properties": {
          "synesisExplorer.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable inline diagnostics (error/warning squiggles) from the Synesis LSP."
          },
          "synesisExplorer.diagnostics.checkCodes": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Warn on every code missing from the ontology, with a suggested concept (same as `synesis compile --check-codes`). Off by default: before the ontology is built every in vivo code is missing, so the project shows a single summary warning on the `.synp` instead."
          },
          "synesisExplorer.inlayHints.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show inline hints after @bibrefs (e.g. \"(Author, Year)\")."
          },
          "synesisExplorer.semanticHighlighting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable AST-based semantic syntax highlighting (more accurate than TextMate grammar). Requires Synesis Dark or Synesis Light theme, or a theme with semanticTokenColors support."
          },
          "synesisExplorer.completion.autoImportCodes": {
            "type": "boolean",
            "default": true,
            "description": "Include ontology codes from the compiled project in autocomplete suggestions."
          }
        }
      },
      {
        "title": "Coder",
        "order": 4,
        "properties": {
          "synesisExplorer.coder.path": {
            "type": "string",
            "default": "synesis-coder",
            "scope": "machine",
            "description": "Path to the synesis-coder executable. Machine-scoped: cannot be overridden by a workspace's .vscode/settings.json."
          }
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "synesis.chatAssistant",
        "name": "synesis",
        "fullName": "Synesis Assistant",
        "description": "Queries the Synesis graph (ArcadeDB, Neo4j).",
        "isSticky": true
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "synesis-anthropic",
        "displayName": "Synesis (Anthropic)"
      },
      {
        "vendor": "synesis-openai",
        "displayName": "Synesis (OpenAI)"
      },
      {
        "vendor": "synesis-gemini",
